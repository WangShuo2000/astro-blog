---
import ArchivePanel from '@components/ArchivePanel.astro'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getTagList, type Tag } from '@utils/content-utils'

interface Props {
  tag: Tag
}

export async function getStaticPaths() {
  const tags = await getTagList()
  return tags.map(tag => ({
    params: {
      tag: tag.name,
    },
    props: { tag },
  }))
}

const { tag } = Astro.props
const title = `#${tag.name} articles`
const description = `Browse ${tag.count} ${tag.count === 1 ? 'article' : 'articles'} tagged “${tag.name}” from the journal.`
---

<MainGridLayout title={title} description={description}>
    <ArchivePanel tags={[tag.name]}></ArchivePanel>
</MainGridLayout>
