---
import { getCategoryList, type Category } from '@utils/content-utils'
import { UNCATEGORIZED_SLUG } from '@utils/category-utils'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import ArchivePanel from '@components/ArchivePanel.astro'

interface Props {
  category: Category
}

export async function getStaticPaths() {
  const categories = await getCategoryList()
  return categories
    .filter(category => category.slug !== UNCATEGORIZED_SLUG)
    .map(category => ({
      params: {
        category: category.slug,
      },
      props: { category },
    }))
}

const { category } = Astro.props
const title = `${category.name} articles`
const description = `Explore ${category.count} ${category.count === 1 ? 'article' : 'articles'} in ${category.name}: notes, ideas, and discoveries from the journal.`
---

<MainGridLayout title={title} description={description}>
    <ArchivePanel categories={[category.slug]}></ArchivePanel>
</MainGridLayout>
