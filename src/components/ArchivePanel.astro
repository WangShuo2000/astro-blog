---
import { Icon } from 'astro-icon/components'
import { getCategoryName, getCategorySlug } from '../utils/category-utils'
import { getSortedPosts, getTagList } from '../utils/content-utils'
import { getPostUrlBySlug, getCategoryUrl, url } from '../utils/url-utils'
import { formatDateToYYYYMMDD } from '../utils/date-utils'
import CategoryNav from './CategoryNav.astro'
interface Props { keyword?: string; tags?: string[]; categories?: string[] }
const { keyword, tags = [], categories = [] } = Astro.props
let posts = await getSortedPosts()
if (tags.length) posts = posts.filter(post => post.data.tags.some(tag => tags.includes(tag)))
if (categories.length) posts = posts.filter(post => categories.some(category => getCategorySlug(category) === getCategorySlug(post.data.category)))
if (keyword) posts = posts.filter(post => `${post.data.title} ${post.data.description}`.toLowerCase().includes(keyword.toLowerCase()))
const years = [...new Set(posts.map(post => post.data.published.getFullYear()))]
const allTags = await getTagList()
const storyCount = (n: number) => `${n} ${n === 1 ? 'STORY' : 'STORIES'}`
const selection = tags.length ? `#${tags[0]}` : categories.length ? getCategoryName(categories[0]) : ''
---
<header class="page-heading archive-heading"><p class="eyebrow">THE COLLECTION / {storyCount(posts.length)}</p><h1>{selection || 'The archive.'}</h1><p>{selection ? 'A closer look at one corner of the journal.' : 'Ideas, experiments, and a few things learned along the way.'}</p>{selection && <a class="text-link" href={url('/archive/')}><Icon name="material-symbols:arrow-back-rounded" /> All writing</a>}</header>
<div class="archive-filters"><CategoryNav selected={categories[0]} /><details class="tag-disclosure"><summary>Browse tags <Icon name="material-symbols:add-rounded" /></summary><nav aria-label="Browse by tag">{allTags.map(tag => <a href={url(`/archive/tag/${encodeURIComponent(tag.name)}/`)} aria-current={tags.includes(tag.name) ? 'page' : undefined}>#{tag.name}<span>{tag.count}</span></a>)}</nav></details></div>
<div class="archive-list">
  {years.map(year => <section class="archive-year" aria-labelledby={`year-${year}`}><header><h2 id={`year-${year}`}>{year}</h2><span class="eyebrow">{storyCount(posts.filter(post => post.data.published.getFullYear() === year).length)}</span></header><div>{posts.filter(post => post.data.published.getFullYear() === year).map(post => <article class="archive-row"><time datetime={formatDateToYYYYMMDD(post.data.published)}>{formatDateToYYYYMMDD(post.data.published).slice(5)}</time><h3><a href={getPostUrlBySlug(post.id)}>{post.data.title}</a></h3><a class="archive-category" href={getCategoryUrl(post.data.category || '')}>{getCategoryName(post.data.category)}</a><a class="archive-arrow" href={getPostUrlBySlug(post.id)} aria-label={`Read ${post.data.title}`}><Icon name="material-symbols:arrow-right-alt-rounded" /></a></article>)}</div></section>)}
  {!posts.length && <p class="empty-state">No stories here yet. <a href={url('/archive/')}>Explore all writing.</a></p>}
</div>
