---
import type { Page } from 'astro'
import { Icon } from 'astro-icon/components'
import { url } from '../../utils/url-utils'
interface Props { page: Page }
const { page } = Astro.props
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(i => i === 1 || i === page.lastPage || Math.abs(i - page.currentPage) <= 1)
---
{page.lastPage > 1 && <nav class="pagination" aria-label="Pagination">
  {page.url.prev && <a data-astro-prefetch href={page.url.prev} rel="prev" aria-label="Previous page"><Icon name="material-symbols:chevron-left-rounded" /></a>}
  {pages.map((number, i) => <>{i > 0 && number - pages[i - 1] > 1 && <span aria-hidden="true">…</span>}<a data-astro-prefetch href={url(number === 1 ? '/' : `/${number}/`)} aria-label={`Page ${number}`} aria-current={number === page.currentPage ? 'page' : undefined}>{number}</a></>)}
  {page.url.next && <a data-astro-prefetch href={page.url.next} rel="next" aria-label="Next page"><Icon name="material-symbols:chevron-right-rounded" /></a>}
</nav>}
