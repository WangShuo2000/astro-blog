---
interface Props {
  class?: string
  style?: string
}

const { class: className, style } = Astro.props
const inviteUrl = 'https://569078.dedicated-afflink.com/#/auth/45Qep1Zq'
---

<div id="tag-invite" class:list={['card-base p-4', className]} style={style}>
  <div class="font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-2">「TAG」</div>
  <p class="text-sm text-neutral-700 dark:text-neutral-300 mb-3 leading-relaxed">
    在浏览器中打开链接立即注册，畅享高速稳定的全球网络加速服务：
    <a class="break-all underline text-[var(--primary)]" href={inviteUrl} target="_blank" rel="noopener noreferrer sponsored">{inviteUrl}</a>
  </p>
  <a
    class="btn-regular rounded-lg h-9 w-full text-sm font-bold active:scale-95"
    href={inviteUrl}
    target="_blank"
    rel="noopener noreferrer sponsored"
  >立即注册</a>
</div>
