---
import { Font } from 'astro:assets'
import GlobalStyles from '@components/GlobalStyles.astro'
import { profileConfig, siteConfig } from '@/config'
import { defaultFavicons } from '../constants/icon'
import { url } from '../utils/url-utils'
import '../base.css'
import '../editorial.css'
interface Props { title?: string; banner?: string; description?: string; lang?: string; setOGTypeArticle?: boolean }
const { title, description, lang, setOGTypeArticle } = Astro.props
const pageTitle = title ? `${title} — ${siteConfig.title}` : `${siteConfig.title} — Notes worth finding.`
const canonical = new URL(Astro.url.pathname, Astro.site)
const favicons = siteConfig.favicon.length ? siteConfig.favicon : defaultFavicons
---
<!doctype html>
<html lang={(lang || siteConfig.lang).replace('_', '-')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description || 'Notes on code, life & everything between. A personal journal by Jack Wang.'} />
    <meta name="author" content={profileConfig.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || pageTitle} />
    <meta property="og:type" content={setOGTypeArticle ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description || pageTitle} />
    {favicons.map(icon => <link rel="icon" href={icon.src.startsWith('/') ? url(icon.src) : icon.src} sizes={icon.sizes} media={icon.theme && `(prefers-color-scheme: ${icon.theme})`} />)}
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={url('/rss.xml')} />
    <link rel="stylesheet" href="https://cdn.staticfile.net/KaTeX/0.16.9/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.classList.toggle('dark', saved === 'dark' || (saved === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches));
      } catch {}
    </script>
    {(setOGTypeArticle || Astro.url.pathname.endsWith("/about/")) && <Font cssVariable="--font-code" />}
    <slot name="head" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8T6Q9YZXQH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments)}
      gtag('js', new Date()); gtag('config', 'G-8T6Q9YZXQH');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <GlobalStyles><slot /></GlobalStyles>
  </body>
</html>
